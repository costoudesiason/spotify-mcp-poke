{
  "name": "spotify-mcp-poke",
  "version": "2.2.0",
  "description": "MCP server exposing the Spotify Web API: playback, search, and full playlist editing.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx scripts/get-refresh-token.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
